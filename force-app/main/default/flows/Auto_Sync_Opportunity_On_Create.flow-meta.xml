<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Sincroniza la Opportunity recien creada a Veleiro (crea el project) via el invocable Apex.</description>
        <name>Sync_Opportunity_To_Veleiro</name>
        <label>Sync Opportunity to Veleiro</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <actionName>VeleiroSyncService</actionName>
        <actionType>apex</actionType>
        <faultConnector>
            <targetReference>Handle_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>opportunityIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>VeleiroSyncService</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <description>Captura el error sin romper la creacion de la Opportunity (terminal).</description>
        <name>Handle_Fault</name>
        <label>Capturar Error</label>
        <locationX>314</locationX>
        <locationY>384</locationY>
        <assignmentItems>
            <assignToReference>varFaultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Si el config "Sync Trigger" esta en auto (y el push esta permitido), sincroniza la Opportunity a Veleiro apenas se crea. Si esta en manual, no hace nada. (El flow de Closed Won es aparte.)</description>
    <environments>Default</environments>
    <interviewLabel>Auto Sync Opportunity On Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Sync Opportunity On Create</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>AND({!$Setup.Veleiro_Config__c.Sync_Trigger__c} = "auto", NOT({!$Setup.Veleiro_Config__c.Sync_Direction__c} = "veleiro_to_sf"), ISBLANK({!$Record.Veleiro_Project_Id__c}))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Sync_Opportunity_To_Veleiro</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varFaultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
